# ─────────────────────────────────────────────────────────────
# AHMAZZ AI — environment configuration
# Copy to .env.local and fill in only what you have.
# Every key is SERVER-ONLY. Never prefix secrets with NEXT_PUBLIC_.
# With no keys at all the app runs in clearly-labelled DEMO MODE.
# ─────────────────────────────────────────────────────────────

# Text / chat / code / writing (any one is enough; first configured wins
# unless TEXT_PROVIDER is set explicitly: openai | anthropic | gemini | demo)
TEXT_PROVIDER=
OPENAI_API_KEY=
# Optional: any OpenAI-compatible API (OpenRouter, Groq, Together, local Ollama…)
OPENAI_BASE_URL=
OPENAI_TEXT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash

# Images (openai | demo)
IMAGE_PROVIDER=
OPENAI_IMAGE_MODEL=gpt-image-1

# Voice: server text-to-speech / speech-to-text (openai | browser)
# "browser" uses the free Web Speech API in the user's browser.
VOICE_PROVIDER=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=whisper-1

# Background removal (optional) — https://www.remove.bg/api
REMOVE_BG_API_KEY=

# Video generation (optional) — any provider exposing an HTTP job API.
# Implement lib/ai/providers/video-http.ts for your vendor.
VIDEO_PROVIDER=
VIDEO_API_URL=
VIDEO_API_KEY=

# Web research (tavily | wikipedia). Wikipedia needs no key.
SEARCH_PROVIDER=
TAVILY_API_KEY=

# Database (optional until you enable persistence — see docs/ARCHITECTURE.md)
DATABASE_URL=postgresql://user:password@localhost:5432/ahmazz

# Auth (Auth.js) — see docs/ARCHITECTURE.md → "Production auth"
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Upload limits (bytes)
MAX_UPLOAD_BYTES=15000000
